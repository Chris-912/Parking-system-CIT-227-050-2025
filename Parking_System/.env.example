# Copy this file to .env and fill in your own values. Never commit .env (it is gitignored).
DARAJA_ENV=sandbox

# Daraja portal -> My Apps -> your app -> Keys.
DARAJA_CONSUMER_KEY=replace_with_sandbox_consumer_key
DARAJA_CONSUMER_SECRET=replace_with_sandbox_consumer_secret

# Sandbox uses Safaricom's shared test shortcode and passkey, so an app with no
# product assigned yet can still send STK Push prompts.
# Production: use the Paybill/Till number and passkey from your own M-Pesa Express product.
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Public HTTPS address for this endpoint. A bare host is upgraded automatically,
# so https://your-public-host becomes https://your-public-host/api/pay/mpesa/callback
DARAJA_CALLBACK_URL=https://your-public-host

DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_ACCOUNT_REFERENCE=Parking

# Optional Flask settings. The debugger is off by default when DARAJA_ENV=production,
# because the Werkzeug debugger allows remote code execution.
# Leave FLASK_DEBUG empty to keep that automatic behaviour.
FLASK_DEBUG=
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
